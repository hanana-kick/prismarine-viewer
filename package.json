  "description": "Prismarine Viewer with Minecraft Java 26.3 (protocol 777) support",
  "main": "index.js",
  "scripts": {
    "jestTest": "jest --verbose --runInBand --forceExit",
    "test": "npm run jestTest",
    "pretest": "npm run lint",
