    "fix": "standard --fix",
    "build": "node scripts/prepare.js --force",
    "verify:mc26": "node scripts/verify-26.3.js",
    "verify:entities": "node scripts/verify-entities-26.3.js"
  },
  "author": "PrismarineJS",
  "license": "MIT",
  "standard": {
    "ignore": [
      "examples/electron/",
      "examples/exporter/",
      "examples/standalone/",
      "examples/web_client/"
    ]
  },
  "dependencies": {
    "@tweenjs/tween.js": "^23.1.1",
    "compression": "^1.7.4",
    "express": "^4.17.1",
    "minecraft-data": "npm:@wp2508/minecraft-data@3.111.7",
    "prismarine-block": "npm:@wp2508/prismarine-block@1.23.1",
    "prismarine-chunk": "npm:@wp2508/prismarine-chunk@1.41.5",
    "prismarine-world": "^3.3.1",
    "socket.io": "^4.0.0",
    "socket.io-client": "^4.0.0",
    "three": "0.128.0",
    "three.meshline": "^1.3.0",
    "vec3": "^0.1.7",
    "prismarine-registry": "npm:@wp2508/prismarine-registry@1.12.1"
  },
  "devDependencies": {
    "assert": "^2.0.0",
    "buffer": "^6.0.3",
    "canvas": "^3.1.0",
    "fs-extra": "^11.0.0",
    "jest": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "minecraft-assets": "^1.19.0",
    "minecraft-wrap": "^1.3.0",
    "minecrafthawkeye": "^1.2.5",
    "mineflayer": "^4.0.0",
    "mineflayer-pathfinder": "^2.0.0",
    "node-canvas-webgl": "PrismarineJS/node-canvas-webgl",
    "prismarine-schematic": "^1.2.0",
    "prismarine-viewer": "file:./",
    "process": "^0.11.10",
    "puppeteer": "^22.8.2",
    "standard": "^17.1.0",
    "webpack": "^5.10.2",
    "webpack-cli": "^6.0.1",
    "extract-zip": "^2.0.1",
    "path-browserify": "^1.0.1"
